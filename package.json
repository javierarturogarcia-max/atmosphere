{
  "name": "atmosphere",
  "version": "1.0.0",
  "description": "Atmosphere \u2014 plataforma gamificada de accion climatica con motor de impacto cientifico, analitica estadistica y recompensas.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node tools/build.mjs",
    "dev": "node tools/servidor.mjs",
    "verify": "npm test && npm run test:db && npm run build",
    "test:db": "node tools/probar-esquema.mjs && node tools/probar-verificador.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "clima",
    "sostenibilidad",
    "gamificacion",
    "huella-de-carbono",
    "calidad-del-aire",
    "pwa"
  ],
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
